{
  "name": "@apexnative/navigation",
  "version": "1.0.0-alpha.1",
  "description": "Native navigation for React Native: platform stacks, tabs, modals and side menus on iOS, iPadOS and Android",
  "keywords": [
    "react-native",
    "navigation",
    "native-navigation",
    "ios",
    "android"
  ],
  "homepage": "https://github.com/apexnative/navigation#readme",
  "bugs": {
    "url": "https://github.com/apexnative/navigation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apexnative/navigation.git"
  },
  "license": "MIT",
  "author": "Artashes Bayazetyan (https://github.com/bayazetyan)",
  "bin": {
    "apex-navigation": "./cli/index.js"
  },
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "apexnative-navigation-source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cli",
    "CHANGELOG.md",
    "docs-md",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/__snapshots__",
    "!**/*.test.*",
    "!android/src/test",
    "!android/src/androidTest",
    "!**/.*"
  ],
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "example": "yarn workspace @apexnative/navigation-example",
    "check:headers": "node scripts/check-license-headers.mjs",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "prepack": "node scripts/docs-md.mjs",
    "typecheck": "tsc && yarn example typecheck",
    "lint": "eslint \"**/*.{js,mjs,ts,tsx}\"",
    "test": "jest"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.85.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "commitlint": "^21.2.1",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.2.0",
    "jest": "^29.7.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.1",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "dependenciesMeta": {
    "lefthook": {
      "built": true
    }
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "codegenConfig": {
    "name": "ApexNavigationSpec",
    "type": "all",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "dev.apexnative.navigation.react"
    },
    "ios": {
      "componentProvider": {
        "ANNSlot": "ANNSlotComponentView",
        "ANNSafeAreaView": "ANNSafeAreaViewComponentView"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.63.1"
  }
}
